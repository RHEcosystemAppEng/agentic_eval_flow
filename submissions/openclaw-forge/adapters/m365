#!/bin/sh
set -eu

# AEH/OpenShell compatibility launcher for the Forge catalog's microsoft365
# skill. The catalog invokes /sandbox/bin/m365 request --url ...; the runner
# supplies M365_GRAPH_CURL, which owns the bearer header and never receives the
# token on argv.
if [ "${1:-}" != "request" ]; then
  echo '{"error":"unsupported m365 operation"}' >&2
  exit 2
fi

shift
url=
method=get
output=json
while [ "$#" -gt 0 ]; do
  case "$1" in
    --url) url=${2:-}; shift 2 ;;
    --method) method=${2:-}; shift 2 ;;
    --output) output=${2:-}; shift 2 ;;
    --resource) shift 2 ;;
    *) shift ;;
  esac
done

if [ -z "$url" ] || [ "$method" != "get" ] || [ "$output" != "json" ]; then
  echo '{"error":"only governed GET JSON requests are supported"}' >&2
  exit 2
fi
if [ -z "${M365_GRAPH_CURL:-}" ] || [ ! -x "$M365_GRAPH_CURL" ]; then
  echo '{"error":"M365_GRAPH_CURL is unavailable"}' >&2
  exit 3
fi

# The logical governed base is intentionally non-public so the catalog skill's
# policy check passes. The runner's file-auth curl helper is the only component
# that resolves the request to Microsoft Graph.
case "$url" in
  http://m365.local/*) url="https://graph.microsoft.com/${url#http://m365.local/}" ;;
  *) echo '{"error":"request is outside the governed M365 base"}' >&2; exit 3 ;;
esac
exec "$M365_GRAPH_CURL" "$url"
