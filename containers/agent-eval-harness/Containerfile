# Local and CI orchestration; trial pods use the separate aeh-trial image.
FROM registry.access.redhat.com/ubi9/python-312:latest
USER 0
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /usr/local/bin/uv
RUN dnf install -y git tar && dnf clean all
COPY pyproject.toml README.md uv.lock /opt/agent-eval-harness/
WORKDIR /opt/agent-eval-harness
RUN uv export --frozen --no-dev --extra runner --extra llm --extra storage --extra observability --no-emit-project --no-hashes --output-file /tmp/runtime-requirements.txt \
    && pip install --no-cache-dir -r /tmp/runtime-requirements.txt \
    && rm /tmp/runtime-requirements.txt
ARG AEH_REPO=https://github.com/fullsend-ai/agent-eval-harness.git
ARG AEH_SHA=8a15a8b687b5561903827805eaae8b438bde9954
RUN git init /opt/aeh/source \
    && git -C /opt/aeh/source remote add origin "${AEH_REPO}" \
    && git -C /opt/aeh/source fetch --depth 1 origin "${AEH_SHA}" \
    && git -C /opt/aeh/source checkout --detach FETCH_HEAD \
    && pip install --no-cache-dir --no-deps --editable /opt/aeh/source
ENV ABEVAL_AEH_ROOT=/opt/aeh/source
COPY abevalflow /opt/agent-eval-harness/abevalflow
RUN pip install --no-cache-dir --no-deps /opt/agent-eval-harness \
    && abeval --version \
    && python3 -c "from abevalflow.execution.runtime import resolve_runtime; resolve_runtime().validate()"
ENV HOME=/workspace
RUN mkdir -p /workspace /logs /tests /solution /harbor /installed-agent \
    && chgrp -R 0 /workspace /logs /tests /solution /harbor /installed-agent /opt/agent-eval-harness \
    && chmod -R g=u /workspace /logs /tests /solution /harbor /installed-agent /opt/agent-eval-harness
WORKDIR /workspace
USER 1001
