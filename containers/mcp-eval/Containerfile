# MCP server evaluation image for ABEvalFlow.
#
# Single image for the full MCP evaluation pipeline: static analysis,
# deterministic conformance testing, and behavioral evaluation (mcpchecker).
#
# Bakes:
#   - the MCP eval code and its full import closure (abevalflow.mcp / gates /
#     schemas / observability, and scripts.mcp) importable via PYTHONPATH=/opt
#   - the scanners/probes it shells out to: gitleaks, semgrep, licensee
#   - the minimal Python deps the code imports: pydantic, pyyaml, httpx
#   - mcpchecker binary + Node.js (copied from mcpchecker-runner)
#   - default behavioral task suite (suites/mcp/default)
#   - mcpchecker result aggregation script
#   - envsubst for runtime MCP_URL injection
#
# Build from repo root (COPY needs repo-root context):
#   podman build -t quay.io/ecosystem-appeng/abevalflow-mcp-eval:0.1 \
#     -f containers/mcp-eval/Containerfile .

# ── Stage 1: mcpchecker-runner (source for mcpchecker binary + Node.js) ──
FROM quay.io/ecosystem-appeng/mcpchecker-runner:latest AS mcpchecker-runner

# ── Stage 2: Runtime image ──
FROM registry.access.redhat.com/ubi9/python-312:latest

ARG GITLEAKS_VERSION=8.30.0
ARG SEMGREP_VERSION=1.179.0
ARG LICENSEE_VERSION=9.18.0
ARG PYDANTIC_VERSION=2.13.5
ARG PYYAML_VERSION=6.0.3
ARG HTTPX_VERSION=0.28.1
ARG JSONSCHEMA_VERSION=4.23.0

USER 0

# Copy mcpchecker binary from mcpchecker-runner
COPY --from=mcpchecker-runner /usr/local/bin/mcpchecker /usr/local/bin/mcpchecker
RUN chmod +x /usr/local/bin/mcpchecker

# MCP eval code — abevalflow core (gates, schemas, observability) and
# scripts.mcp (Tekton entry points, fact generation, evaluation models).
COPY abevalflow/__init__.py  /opt/abevalflow/__init__.py
COPY abevalflow/schemas.py  /opt/abevalflow/schemas.py
COPY abevalflow/mcp         /opt/abevalflow/mcp
COPY abevalflow/gates /opt/abevalflow/gates
COPY abevalflow/observability /opt/abevalflow/observability
COPY scripts/__init__.py /opt/scripts/__init__.py
COPY scripts/mcp /opt/scripts/mcp

# Behavioral eval: aggregation script + task suites
COPY abevalflow/mcpchecker_report.py /opt/abevalflow/mcpchecker_report.py
COPY abevalflow/report.py            /opt/abevalflow/report.py
COPY scripts/aggregate_mcpchecker.py /opt/scripts/aggregate_mcpchecker.py
COPY suites/mcp/default              /opt/suites/mcp/default

# JSON Schemas for summary and fact file validation
COPY schemas /opt/schemas

# Kubernetes Job templates for conformance, behavioral evaluation, and Compass publishing
COPY templates/mcp-conformance-eval-job.yaml  /opt/templates/mcp-conformance-eval-job.yaml
COPY templates/mcp-behavioral-eval-job.yaml   /opt/templates/mcp-behavioral-eval-job.yaml
COPY templates/mcp-compass-publish-job.yaml   /opt/templates/mcp-compass-publish-job.yaml

ENV PYTHONPATH=/opt

# Node.js (mcpchecker MCP protocol support), envsubst (runtime config injection),
# Python deps.
# licensee's native dep (rugged -> libgit2) needs a build toolchain to compile;
# install it, build the gem, then drop the toolchain to keep the image lean.
RUN dnf install -y nodejs npm gettext --nodocs \
 && curl -LsSf \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
      | tar -xz -C /usr/local/bin gitleaks \
 && pip install --no-cache-dir \
      "semgrep==${SEMGREP_VERSION}" \
      "pydantic==${PYDANTIC_VERSION}" \
      "pyyaml==${PYYAML_VERSION}" \
      "httpx==${HTTPX_VERSION}" \
      "jsonschema==${JSONSCHEMA_VERSION}" \
 && dnf install -y ruby ruby-devel gcc gcc-c++ make cmake pkgconf-pkg-config openssl-devel \
 && gem install licensee -v "${LICENSEE_VERSION}" \
 && dnf remove -y ruby-devel gcc gcc-c++ make cmake pkgconf-pkg-config openssl-devel \
 && dnf clean all

USER 1001
WORKDIR /workspace
