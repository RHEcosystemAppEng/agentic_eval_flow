# Placeholder SSH identity for virtctl / SAW setup Job (chart sshSecret).
# Generate with `make generate-keys` in the forge-saw clone, then:
#   oc create secret generic openshell-aap-ssh -n guy-ziv-evalflow --from-file=key=~/.generated-ssh-keys/sandbox-ssh
apiVersion: v1
kind: Secret
metadata:
  name: openshell-aap-ssh
  namespace: guy-ziv-evalflow
  labels:
    app.kubernetes.io/part-of: abevalflow
    app.kubernetes.io/component: forge-saw
type: Opaque
stringData:
  key: "<replace-with-ssh-private-key>"
  public_key: "<replace-with-ssh-public-key>"
